# Optional Homebrew packages for native reverse engineering: `brew bundle`
# (docs/SETUP.md, step 8). Builds and tests don't need any of this: they run
# in the dev image (scripts/dev), which has the ARM toolchain, LLVM, Python
# and Node. Ghidra is not a Homebrew package; install it with
# scripts/install-ghidra.sh.

brew "openjdk@21"    # JDK for Ghidra 12.1
brew "node"          # optional: npx runs the REA MCP server (rea-agents)
