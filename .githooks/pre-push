#!/usr/bin/env bash
# Optional local safety net (scripts/install-hooks.sh): refuse to push any
# commit that adds firmware or generated files, also ones committed without
# the pre-commit hook.
set -uo pipefail

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha _remote_ref remote_sha; do
    [[ "$local_sha" == "$zero" ]] && continue  # deletion
    if [[ "$remote_sha" == "$zero" ]]; then
        range="$local_sha --not --remotes"
    else
        range="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086
    bad="$(git rev-list $range | while read -r c; do
        git diff-tree --no-commit-id --name-only -r --diff-filter=A "$c"
    done | grep -E '\.(syx|bin|elf|dis)$|^work/|^firmware/' | grep -v '^firmware/README\.md$' | sort -u)"
    if [[ -n "$bad" ]]; then
        echo "pre-push: $local_ref adds firmware or generated files; not pushing:" >&2
        echo "$bad" >&2
        status=1
    fi
done
exit "$status"
